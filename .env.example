# Copie este arquivo para .env antes de rodar o projeto:
#   cp .env.example .env
# No Windows (PowerShell):
#   Copy-Item .env.example .env

# Porta do servidor local (Vite)
VITE_PORT=5173

# Nome exibido no produto
VITE_APP_NAME=Rota

# URL base da API (placeholder para o MVP — os dados atuais são mockados no frontend)
VITE_API_URL=http://localhost:3333

# Integração futura com WhatsApp (não usada neste MVP)
VITE_WHATSAPP_ENABLED=false
